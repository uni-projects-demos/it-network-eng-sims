    "eventSend": "Ուղղորդիչ #{router}-ը #{peer} ուղղորդիչին ուղարկեց RIP v2 պատասխան՝ {entries} գրառումով ({bytes} բայթ)",
    "triggeredSuffix": "(գործարկված)",
    "eventPacketDropped": "Ուղղորդիչ #{router}-ը մերժեց #{peer}-ից ստացված անվավեր RIP փաթեթը",
    "eventRecovered": "Ուղղորդիչ #{router}-ը կրկին RIP թարմացումներ է ստանում #{peer} ուղղորդիչից",
    "eventReceive": "Ուղղորդիչ #{router}-ը ստացավ վավեր RIP v2 պատասխան #{peer} ուղղորդիչից ({entries} գրառում)",
    "eventInvalidate": "Ուղղորդիչ #{router}՝ դեպի #{destination} երթուղին #{oldHop}-ի միջոցով անվավեր ճանաչվեց ({oldMetric} → 16)",
    "eventDiscover": "Ուղղորդիչ #{router}՝ հայտնաբերեց #{destination}-ը #{newHop}-ի միջոցով (մետրիկա {newMetric})",
    "eventRouteChange": "Ուղղորդիչ #{router}՝ դեպի #{destination} ամենակարճ ուղին փոխվեց՝ #{oldHop} → #{newHop}, մետրիկա {oldMetric} → {newMetric}",
    "eventConverged": "Ցանցը կոնվերգենցիայի հասավ {seconds} վրկ-ից"
  }
}
