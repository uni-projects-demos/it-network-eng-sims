    "eventPacketDropped": "#{router} маршрутизаторы #{peer} жіберген жарамсыз RIP пакетін тастады",
    "eventRecovered": "#{router} маршрутизаторы #{peer} маршрутизаторынан RIP жаңартуларын қайта қабылдауда",
    "eventReceive": "#{router} маршрутизаторы #{peer} маршрутизаторынан жарамды RIP v2 жауабын қабылдады ({entries} жазба)",
    "eventInvalidate": "#{router} маршрутизаторы: #{oldHop} арқылы #{destination} бағытына маршрут жарамсыз деп танылды ({oldMetric} → 16)",
    "eventDiscover": "#{router} маршрутизаторы: #{newHop} арқылы #{destination} бағытына маршрут табылды (метрика {newMetric})",
    "eventRouteChange": "#{router} маршрутизаторы: #{destination} бағытына ең қысқа жол өзгерді: #{oldHop} → #{newHop}, метрика {oldMetric} → {newMetric}",
    "eventConverged": "Желі {seconds} с ішінде жинақталды"
  }
}
