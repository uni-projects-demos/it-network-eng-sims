    "eventInvalidate": "मार्गनिर्देशकः #{router}: #{oldHop} द्वारा #{destination} प्रति मार्गोऽमान्यीकृतः ({oldMetric} → 16)",
    "eventDiscover": "मार्गनिर्देशकः #{router}: #{newHop} द्वारा #{destination} अन्विष्टम् (मापनाङ्कः {newMetric})",
    "eventRouteChange": "मार्गनिर्देशकः #{router}: #{destination} प्रति लघुतममार्गः परिवर्तितः: #{oldHop} → #{newHop}, मापनाङ्कः {oldMetric} → {newMetric}",
    "eventConverged": "{seconds} क्षणानन्तरं जालम् अभिसृतम्"
  }
}
